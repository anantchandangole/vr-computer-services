# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# For MongoDB Atlas (Cloud) - Recommended for Production
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/vr-computer-services?retryWrites=true&w=majority

# For Local Development (uncomment for development)
# MONGODB_URI=mongodb://localhost:27017/vr-computer-services

# JWT Secret - CHANGE THIS IN PRODUCTION!
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345

# CORS Configuration (separate by comma for multiple origins)
CORS_ORIGIN=http://localhost:5000,http://localhost:3000

# File Upload Configuration
UPLOAD_PATH=./imag
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Logging Level (debug, info, warn, error)
LOG_LEVEL=debug

# Email Configuration (Optional - for future notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password

# Google Maps API Key (Optional - for future map integrations)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
